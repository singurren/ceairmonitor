{
  "manifest_version": 3,
  "name": "Ceair Monitor Bridge",
  "version": "0.1.0",
  "description": "Capture China Eastern flight-list responses and forward them to the local ceair monitor service.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "https://m.ceair.com/*",
    "https://ecactivity.ceair.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://m.ceair.com/*",
        "https://ecactivity.ceair.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "options_page": "options.html",
  "web_accessible_resources": [
    {
      "resources": [
        "page-hook.js"
      ],
      "matches": [
        "https://m.ceair.com/*",
        "https://ecactivity.ceair.com/*"
      ]
    }
  ]
}
